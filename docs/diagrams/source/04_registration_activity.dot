digraph G {
graph [bgcolor="white", pad="0.25", nodesep="0.40", ranksep="0.55", fontname="DejaVu Sans", fontsize=13];
node [shape=box, style="rounded,filled", fillcolor="#EDF4F7", color="#8EA8B7", fontcolor="#19384B", fontname="DejaVu Sans", fontsize=13, margin="0.20,0.13", penwidth=1.2];
edge [color="#5F7280", fontcolor="#334F60", fontname="DejaVu Sans", fontsize=10, arrowsize=0.8, penwidth=1.2];
rankdir=TB; nodesep=0.25; ranksep=0.35;
start [shape=oval,label="Student submits Register",fillcolor="#DDEEEF"];
auth [label="Check session, Student role and CSRF"];
tx [label="BEGIN atomic write transaction
Serialize on event allocation write"];
valid [shape=diamond,label="Published and
now < closes?",fillcolor="white"];
reject [label="Reject with no change
Rollback on failure",fillcolor="#FFF1E8"];
existing [shape=diamond,label="Already Confirmed
or Waitlisted?",fillcolor="white"];
same [label="Return existing record/status
No second allocation"];
space [shape=diamond,label="Seat available and
no earlier waiter?",fillcolor="white"];
confirmed [label="Create / reuse row as Confirmed
Set confirmation time"];
wait [label="Create / reuse row as Waitlisted
Order by joined_at, then id"];
rejoin [label="For a previously Cancelled row:
new joined_at; clear cancellation / attendance
Keep the unique student + event record"];
commit [shape=oval,label="COMMIT and return own result",fillcolor="#DDEEEF"];
start -> auth -> tx -> valid;
valid -> reject [label="no"];
valid -> existing [label="yes"];
existing -> same [label="yes"];
same -> commit;
existing -> space [label="no"];
space -> confirmed [label="yes"];
space -> wait [label="no"];
confirmed -> rejoin; wait -> rejoin; rejoin -> commit;
note [shape=note,label="No GET mutation; one row per Student/event.
Busy/locked database: rollback, HTTP 503
with Retry-After. At the closing instant,
registration is already closed.",fillcolor="white"];
commit -> note [style=invis];
}
